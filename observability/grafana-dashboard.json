      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "expr": "sum(weroad_guardrail_checks_total{decision=\"blocked\"}) or vector(0)",
          "legendFormat": "Blocked",
          "refId": "A"
